{
  "name": "mycollection",
  "version": "1.0.0",
  "description": "MyCollection — gestionnaire de collections (Electron + Angular + Prisma)",
  "author": "Nicolas Wattiaux",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "seed": "ts-node prisma/seed.ts",
    "build:angular": "ng build --configuration production",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:angular && npm run build:electron",
    "start": "npm run build && electron .",
    "dev:angular": "ng serve",
    "dev:electron": "tsc -p tsconfig.electron.json && electron . --serve"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@prisma/client": "^5.20.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@types/node": "^20.14.0",
    "electron": "^31.0.0",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.4"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
